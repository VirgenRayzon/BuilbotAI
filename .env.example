# ==============================================================================
# Buildbot AI — Environment Variables Template
# Copy this file to .env.local for local development.
# Configure these variables in the Vercel Project Settings for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public)
# Required for client-side Firebase Auth, Firestore, and Cloud Storage.
# Obtain from Firebase Console > Project Settings > General > Your Apps (Web).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="buildbot-ai.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="buildbot-ai"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="buildbot-ai.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# ------------------------------------------------------------------------------
# 2. Application & Canonical Domain URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://buildbot.ph"
NEXT_PUBLIC_QR_ORIGIN="https://buildbot.ph"

# ------------------------------------------------------------------------------
# 3. Google Gemini & Genkit AI (Server-side)
# Required for AI Build Advisor, critique flows, and parts extractor.
# Obtain from Google AI Studio (https://aistudio.google.com/).
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSy..."
# Alternatively supported aliases:
# GOOGLE_API_KEY="AIzaSy..."
# GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# Optional: Fine-tuned Vertex / Genkit model endpoint
# GEMINI_FINE_TUNED_MODEL="tunedModels/buildbot-hardware-advisor-v1"
# GOOGLE_VERTEX_LOCATION="us-central1"

# ------------------------------------------------------------------------------
# 4. Firebase Admin SDK Service Account (Server-side)
# JSON string of service account key from Firebase Console > Project Settings > Service accounts.
# In Vercel, store the raw JSON string as FB_SERVICE_ACCOUNT or FIREBASE_SERVICE_ACCOUNT.
# ------------------------------------------------------------------------------
FB_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}'
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# ------------------------------------------------------------------------------
# 5. PayMongo Payment Gateway Integration (Server-side)
# Required for Checkout: GCash, Maya, Credit/Debit card payments.
# Obtain from PayMongo Dashboard > Developers > API Keys.
# ------------------------------------------------------------------------------
PAYMONGO_SECRET_KEY="sk_live_..."
PAYMONGO_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 6. Administrative Role Setup Keys
# Used to authenticate staff roles during initial onboarding or recovery.
# ------------------------------------------------------------------------------
SUPER_ADMIN_SETUP_KEY="SUPER_ADMIN_123"
MANAGER_SETUP_KEY="00216764"

# ------------------------------------------------------------------------------
# 7. Operational Cron & Background Tasks
# Secret used by Vercel Cron to trigger /api/cron/expire-orders securely.
# ------------------------------------------------------------------------------
CRON_SECRET="your-secure-random-cron-token"

# ------------------------------------------------------------------------------
# 8. Feature Flags & Pagination
# ------------------------------------------------------------------------------
NEXT_PUBLIC_INVENTORY_PAGINATION_ENABLED="true"
NEXT_PUBLIC_PUBLIC_CATALOG_INDEXED_ENABLED="true"

# ------------------------------------------------------------------------------
# 9. Support & Gmail Integration (Optional)
# ------------------------------------------------------------------------------
# CONTACT_SUPPORT_EMAIL="support@buildbot.ph"
# GMAIL_CLIENT_ID="..."
# GMAIL_CLIENT_SECRET="..."
# GMAIL_REFRESH_TOKEN="..."
# GMAIL_REDIRECT_URI="https://buildbot.ph/api/contact/gmail/oauth/callback"
# GMAIL_TOKEN_ENCRYPTION_KEY="..."
# GMAIL_PUBSUB_TOPIC="projects/buildbot-ai/topics/support-tickets"
# GMAIL_PUBSUB_SERVICE_ACCOUNT="..."
# GMAIL_PUBSUB_AUDIENCE="..."
# GMAIL_WATCH_CRON_SECRET="..."

