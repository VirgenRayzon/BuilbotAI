
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isManager() {
      return request.auth != null && (request.auth.token.get('isManager', false) == true || request.auth.token.get('isSuperAdmin', false) == true);
    }

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.isSuperAdmin == true;
    }

    function isInventoryCategory(category) {
      return category in ['cpu', 'gpu', 'motherboard', 'ram', 'storage', 'psu',
                          'case', 'cooler', 'monitor', 'keyboard', 'mouse', 'headset'];
    }

    function identityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['productId', 'sku', 'qrToken', 'schemaVersion']);
    }

    // Private allocation and routing metadata is accessed only by verified server code.
    match /catalogCounters/{id} { allow read, write: if false; }
    match /catalogOperations/{id} { allow read, write: if false; }
    match /catalogNames/{id} { allow read, write: if false; }
    match /productIds/{id} { allow read, write: if false; }
    match /productSkus/{id} { allow read, write: if false; }
    match /qrLinks/{id} { allow read, write: if false; }
    match /reservationOperations/{id} { allow read, write: if false; }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read, delete: if request.auth.uid == userId || isManager();
      allow create: if request.auth.uid == userId 
                    && request.resource.data.get('isManager', false) == false
                    && request.resource.data.get('isSuperAdmin', false) == false;
      allow update: if (request.auth.uid == userId && (
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['isManager', 'isSuperAdmin', 'activeManagerKey', 'deprecatedKeys'])
                    )) || isSuperAdmin();

      match /favorites/{favoriteId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /notifications/{notifId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    match /authKeys/{keyId} {
      allow get: if true;
      allow list, write: if request.auth != null && isSuperAdmin();
    }

    match /keyRequests/{requestId} {
      allow create: if true;
      allow read, write: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isManager());
      // Users can cancel their own orders
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.userId && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        isManager()
      );
      allow delete: if isSuperAdmin();
    }

    match /notifications/{notifId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /system_notifications/{notifId} {
      allow read, write: if isManager();
    }

    // Contact inquiries are written only by verified server routes. Customers
    // can read their own signed-in conversations; guests communicate by email.
    match /contactInquiries/{inquiryId} {
      allow read: if isManager() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isManager() || (
          request.auth != null &&
          get(/databases/$(database)/documents/contactInquiries/$(inquiryId)).data.userId == request.auth.uid
        );
        allow create, update, delete: if false;
      }
    }

    match /contactRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /contactMailAliases/{aliasId} {
      allow read, write: if false;
    }

    match /contactOAuthStates/{stateId} {
      allow read, write: if false;
    }

    match /contactSecrets/{secretId} {
      allow read, write: if false;
    }

    match /contactMailboxes/{mailboxId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isManager();
      allow create: if isManager();
      allow update, delete: if isSuperAdmin();
    }

    match /user_auditLogs/{logId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isManager());
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.userId || isManager());
      allow update, delete: if isSuperAdmin();
    }

    match /parts/{partId} {
      allow read: if true;
      allow update: if request.auth != null && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'popularity']);
      allow write: if isManager();
    }

    match /prebuiltSystems/{systemId} {
      allow read: if true;
      allow create: if false;
      allow update: if isManager() && identityUnchanged();
      allow delete: if isSuperAdmin();
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /inventory/{categorySlug} {
      allow read: if isInventoryCategory(categorySlug);
      allow write: if isInventoryCategory(categorySlug) && isManager();

      match /items/{partId} {
        allow read: if isInventoryCategory(categorySlug);
        allow create: if false;
        allow update: if isInventoryCategory(categorySlug) && isManager() && identityUnchanged();
        allow delete: if isInventoryCategory(categorySlug) && isSuperAdmin();
      }
    }

    // Keep known legacy category paths available until the application cutover.
    match /{category}/{partId} {
      allow read: if category in ['CPU', 'GPU', 'Motherboard', 'RAM', 'Storage', 'PSU', 'Case', 'Cooler', 'Monitor', 'Keyboard', 'Mouse', 'Headset'];
      allow update: if request.auth != null &&
                    category in ['CPU', 'GPU', 'Motherboard', 'RAM', 'Storage', 'PSU', 'Case', 'Cooler', 'Monitor', 'Keyboard', 'Mouse', 'Headset'] &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'popularity']);
      allow write: if category in ['CPU', 'GPU', 'Motherboard', 'RAM', 'Storage', 'PSU', 'Case', 'Cooler', 'Monitor', 'Keyboard', 'Mouse', 'Headset'] && isManager();
    }
  }
}
